{
  "name": "flickpick-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "flickpick web app: a personal movie recommender that runs in the browser over the flickpick TypeScript core.",
  "license": "MIT",
  "scripts": {
    "prepare-data": "node scripts/prepare-data.mjs",
    "predev": "npm run prepare-data",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@radix-ui/react-slider": "^1.5.0",
    "@zodal/core": "^0.2.0",
    "@zodal/store": "^0.2.0",
    "@zodal/store-localstorage": "^0.2.0",
    "@zodal/ui": "^0.2.0",
    "acture": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "flickpick": "file:../js",
    "immer": "^10.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.2.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
